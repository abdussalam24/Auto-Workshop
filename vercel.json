{
    "builds": [
        {
            "src": "frontend/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "backend/api/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "index.php",
            "use": "vercel-php@0.7.2"
        }
    ],
    "routes": [
        {
            "src": "/backend/(.*)",
            "dest": "/backend/$1"
        },
        {
            "src": "/frontend/(.*)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/",
            "dest": "/frontend/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}