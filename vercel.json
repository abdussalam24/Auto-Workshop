{
    "builds": [
        {
            "src": "frontend/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "backend/api/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "index.php",
            "use": "vercel-php@0.7.2"
        }
    ],
    "routes": [
        {
            "src": "/backend/api/(.*)",
            "dest": "/backend/api/$1"
        },
        {
            "src": "/frontend/assets/(.*)",
            "dest": "/frontend/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}